NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug
DATABASE_URL=postgresql://convo:convo@localhost:5432/convo?schema=public
TEST_DATABASE_URL=postgresql://convo:convo@localhost:5432/convo_test?schema=public
DATABASE_CONNECTION_TIMEOUT_MS=5000
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
JWT_ISSUER=convo-api
JWT_AUDIENCE=convo-client
CLIENT_ORIGINS=http://localhost:5173
ATTACHMENT_STORAGE_DRIVER=local
LOCAL_STORAGE_DIRECTORY=./storage
LOCAL_STORAGE_SIGNING_SECRET=replace-with-at-least-32-random-characters
LOCAL_STORAGE_URL_TTL_SECONDS=300
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=convo-attachments
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-object-storage-access-key
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-object-storage-secret-key
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_PRESIGN_TTL_SECONDS=300
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret
CLOUDINARY_DOWNLOAD_URL_TTL_SECONDS=300
